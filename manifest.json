{
  "manifest_version": 3,
  "name": "Knowledge Dump",
  "description": "Highlight text anywhere to send it to your knowledge webhook with context.",
  "version": "1.0.0",
  "permissions": ["storage"],
  "host_permissions": ["<all_urls>"],
  "options_page": "options.html",
  "action": {
    "default_popup": "popup.html",
    "default_title": "Knowledge Dump"
  },
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["contentScript.js"],
      "run_at": "document_idle"
    }
  ]
}
